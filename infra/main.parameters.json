{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "environmentName": { "value": "${AZURE_ENV_NAME}" },
      "location": { "value": "${AZURE_LOCATION}" },
      "owner": { "value": "${OWNER_EMAIL}" },
      "cosmosNetworkMode": { "value": "${COSMOS_NETWORK_MODE}" },
      "enableCmk": { "value": "${ENABLE_CMK}" },
      "vnetAddressPrefix": { "value": "${VNET_ADDRESS_PREFIX}" },
      "webAppSubnetAddressPrefix": { "value": "${WEBAPP_SUBNET_ADDRESS_PREFIX}" },
      "privateEndpointSubnetAddressPrefix": { "value": "${PRIVATE_ENDPOINT_SUBNET_ADDRESS_PREFIX}" },
      "fabricSubnetAddressPrefix": { "value": "${FABRIC_SUBNET_ADDRESS_PREFIX}" },
      "fabricWorkspaceId": { "value": "${FABRIC_WORKSPACE_ID}" },
      "fabricTenantId": { "value": "${FABRIC_TENANT_ID}" },
      "fabricWorkspacePrincipalId": { "value": "${FABRIC_WORKSPACE_PRINCIPAL_ID}" }
    }
}
