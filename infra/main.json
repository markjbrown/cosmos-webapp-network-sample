      "owner": "[parameters('owner')]"
    },
    "cosmosDatabaseName": "CosmosMirrorDatabase",
    "cosmosContainerName": "Items",
    "cosmosContainerMaxThroughput": 1000,
    "resourceGroupName": "[format('rg-{0}', parameters('environmentName'))]",
    "cosmosAccountName": "[format('cosmos-{0}', parameters('environmentName'))]",
