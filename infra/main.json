          "cosmosAccountName": {
            "value": "[variables('cosmosAccountName')]"
          },
          "cosmosDatabaseName": {
            "value": "[variables('cosmosDatabaseName')]"
          },
          "cosmosContainerName": {
            "value": "[variables('cosmosContainerName')]"
          },
          "cosmosContainerMaxThroughput": {
            "value": "[variables('cosmosContainerMaxThroughput')]"
          },
          "secondaryLocation": {
            "value": "[parameters('secondaryLocation')]"
          },
          "webAppName": {
            "value": "[variables('webAppName')]"
          },
          "appServicePlanName": {
            "value": "[variables('appServicePlanName')]"
          },
          "enableCmk": {
            "value": "[parameters('enableCmk')]"
          }
