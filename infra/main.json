                "privateLinkServiceConnections": [
                  {
                    "name": "cosmos-connection",
                    "properties": {
                      "privateLinkServiceId": "[resourceId('Microsoft.DocumentDB/databaseAccounts', parameters('cosmosAccountName'))]",
