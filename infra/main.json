    "vnetName": "[format('vnet-{0}', parameters('environmentName'))]",
    "webAppSubnetName": "snet-webapp",
    "privateEndpointSubnetName": "snet-privateendpoints",
    "fabricGatewaySubnetName": "snet-fabric",
    "appServicePlanName": "[format('asp-{0}', variables('webAppName'))]",
    "effectiveVnetAddressPrefix": "[if(empty(parameters('vnetAddressPrefix')), '172.21.1.0/24', parameters('vnetAddressPrefix'))]",
    "effectiveWebAppSubnetAddressPrefix": "[if(empty(parameters('webAppSubnetAddressPrefix')), '172.21.1.0/27', parameters('webAppSubnetAddressPrefix'))]",
    "effectivePrivateEndpointSubnetAddressPrefix": "[if(empty(parameters('privateEndpointSubnetAddressPrefix')), '172.21.1.32/27', parameters('privateEndpointSubnetAddressPrefix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
